# Ignore large data files (download instructions in data/README.md)
data/*
!data/README.md
!data/.gitkeep

# Manuscript and working documents
docs/


# Root-level shapefiles and large CSVs (pipeline outputs - not for version control)
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
subclusters_done.csv
postcode_subcluster_map.csv

# Allow tracking output CSVs and shapefiles inside the dedicated outputs folder
!classification_outputs/*.csv
!classification_outputs/*.shp
!classification_outputs/*.shx
!classification_outputs/*.dbf
!classification_outputs/*.prj
!classification_outputs/*.cpg

# Jupyter Notebook artifacts
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Python cache
__pycache__/
*.py[cod]

# R artifacts
.Rhistory
.RData

# OS
.DS_Store
Thumbs.db
